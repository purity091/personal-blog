[["Map",1,2,9,10],"meta::meta",["Map",3,4,5,6,7,8],"astro-version","5.18.1","content-config-digest","46486deef83c4c9a","astro-config-digest","{\"root\":{},\"srcDir\":{},\"publicDir\":{},\"outDir\":{},\"cacheDir\":{},\"site\":\"https://lahlah.ai\",\"compressHTML\":true,\"base\":\"/\",\"trailingSlash\":\"ignore\",\"output\":\"server\",\"scopedStyleStrategy\":\"attribute\",\"build\":{\"format\":\"directory\",\"client\":{},\"server\":{},\"assets\":\"_astro\",\"serverEntry\":\"entry.mjs\",\"redirects\":false,\"inlineStylesheets\":\"auto\",\"concurrency\":1},\"server\":{\"open\":false,\"host\":false,\"port\":4321,\"streaming\":true,\"allowedHosts\":[]},\"redirects\":{},\"image\":{\"endpoint\":{\"route\":\"/_image\"},\"service\":{\"entrypoint\":\"astro/assets/services/sharp\",\"config\":{}},\"domains\":[],\"remotePatterns\":[],\"responsiveStyles\":false},\"devToolbar\":{\"enabled\":true},\"markdown\":{\"syntaxHighlight\":{\"type\":\"shiki\",\"excludeLangs\":[\"math\"]},\"shikiConfig\":{\"langs\":[],\"langAlias\":{},\"theme\":\"github-dark\",\"themes\":{},\"wrap\":true,\"transformers\":[]},\"remarkPlugins\":[],\"rehypePlugins\":[],\"remarkRehype\":{},\"gfm\":true,\"smartypants\":true},\"security\":{\"checkOrigin\":true,\"allowedDomains\":[],\"actionBodySizeLimit\":1048576},\"env\":{\"schema\":{},\"validateSecrets\":false},\"experimental\":{\"clientPrerender\":false,\"contentIntellisense\":false,\"headingIdCompat\":false,\"preserveScriptOrder\":false,\"liveContentCollections\":false,\"csp\":false,\"staticImportMetaEnv\":false,\"chromeDevtoolsWorkspace\":false,\"failOnPrerenderConflict\":false,\"svgo\":false},\"legacy\":{\"collections\":false}}","blog",["Map",11,12,39,40],"wqewqe",{"id":11,"data":13,"body":23,"filePath":24,"digest":25,"rendered":26,"legacyId":38},{"title":11,"description":14,"date":15,"updatedDate":16,"image":17,"tags":20,"category":21,"featured":22,"draft":22},"qwewe",["Date","2026-04-12T00:00:00.000Z"],["Date","2026-04-12T00:00:00.000Z"],{"src":18,"alt":19},"/blog/dgbqh45zxuioiai7a39n7t072a0vcurn61nlq8klszmmkmt4a3.webp","صورة المقال",[],"الذكاء الاصطناعي",false,"deqweqwe","src/content/blog/wqewqe.md","c55fec59d3a962a1",{"html":27,"metadata":28},"\u003Cp>deqweqwe\u003C/p>",{"headings":29,"localImagePaths":30,"remoteImagePaths":31,"frontmatter":32,"imagePaths":37},[],[],[],{"title":11,"description":14,"date":33,"updatedDate":34,"image":35,"tags":36,"category":21,"featured":22,"draft":22},["Date","2026-04-12T00:00:00.000Z"],["Date","2026-04-12T00:00:00.000Z"],{"alt":19,"src":18},[],[],"wqewqe.md","introduction-to-neural-networks",{"id":39,"data":41,"body":55,"filePath":56,"digest":57,"rendered":58,"legacyId":88},{"title":42,"description":43,"date":44,"image":45,"tags":48,"category":52,"readingTime":53,"featured":54,"draft":22},"مقدمة في الشبكات العصبية: كيف تفكر الآلة؟","رحلة مبسطة لفهم كيف تعمل الشبكات العصبية الاصطناعية، من الخلية العصبية الواحدة إلى الشبكات العميقة المعقدة",["Date","2026-04-11T00:00:00.000Z"],{"src":46,"alt":47},"/blog/neural-networks-intro.jpg","رسم توضيحي للشبكات العصبية الاصطناعية",[49,50,21,51],"شبكات عصبية","تعلم الآلة","Python","الشبكات العصبية",8,true,"# مقدمة في الشبكات العصبية: كيف تفكر الآلة؟\n\nهل تساءلت يوماً كيف يستطيع هاتفك التعرف على وجهك؟ أو كيف يترجم Google النصوص بين اللغات؟ السر يكمن في **الشبكات العصبية الاصطناعية**.\n\nفي هذا المقال، سنأخذك في رحلة مبسطة لفهم أحد أعظم الاختراعات التقنية في تاريخ البشرية.\n\n## ما هي الشبكات العصبية؟\n\nالشبكات العصبية هي نماذج حاسوبية مستوحاة من **هيكلية الدماغ البشري**. تتكون من:\n\n- **الخلايا العصبية (Neurons)**: وحدات معالجة صغيرة\n- **الروابط (Connections)**: تمرر المعلومات بين الخلايا\n- **الأوزان (Weights)**: تحدد قوة كل رابط\n\n```python\nimport numpy as np\n\nclass SimpleNeuron:\n    def __init__(self, input_size):\n        self.weights = np.random.randn(input_size)\n        self.bias = np.random.randn(1)\n    \n    def activate(self, x):\n        return np.dot(x, self.weights) + self.bias\n```\n\n## كيف تعمل الخلية العصبية؟\n\nتخيل أن الخلية العصبية مثل **مصفاة ذكية**:\n\n1. تستقبل مدخلات متعددة\n2. تضرب كل مدخل في وزنه\n3. تجمع النتائج\n4. تمررها عبر دالة تنشيط\n\n### دالة Sigmoid\n\n```python\ndef sigmoid(x):\n    return 1 / (1 + np.exp(-x))\n```\n\nهذه الدالة تحول أي رقم إلى قيمة بين 0 و 1، مثالية للاحتمالات!\n\n## من خلية واحدة إلى شبكة عميقة\n\nعندما نربط مئات الخلايا العصبية معاً في طبقات متعددة، نحصل على:\n\n| النوع | الوصف | الاستخدام |\n|-------|-------|-----------|\n| **الشبكات الضحلة** | طبقة أو اثنتين | مشاكل بسيطة |\n| **الشبكات العميقة** | 10+ طبقات | رؤية حاسوبية، NLP |\n| **المحولات (Transformers)** | بنية متقدمة | ChatGPT، الترجمة |\n\n## الخلاصة\n\nالشبكات العصبية ليست سحراً، بل هي **رياضيات منظمة** مع الكثير من البيانات. في المقالات القادمة، سنغوص أعمق في كل نوع!\n\n---\n\n> 💡 **نصيحة**: ابدأ دائماً بفهم الخلية العصبية الواحدة قبل الانتقال للشبكات المعقدة.\n\n**هل أعجبك المقال؟** [اشترك في النشرة البريدية](#) للحصول على جديدنا كل أسبوع!","src/content/blog/introduction-to-neural-networks.md","05d9c1e92b5b411f",{"html":59,"metadata":60},"\u003Ch1 id=\"مقدمة-في-الشبكات-العصبية-كيف-تفكر-الآلة\">مقدمة في الشبكات العصبية: كيف تفكر الآلة؟\u003C/h1>\n\u003Cp>هل تساءلت يوماً كيف يستطيع هاتفك التعرف على وجهك؟ أو كيف يترجم Google النصوص بين اللغات؟ السر يكمن في \u003Cstrong>الشبكات العصبية الاصطناعية\u003C/strong>.\u003C/p>\n\u003Cp>في هذا المقال، سنأخذك في رحلة مبسطة لفهم أحد أعظم الاختراعات التقنية في تاريخ البشرية.\u003C/p>\n\u003Ch2 id=\"ما-هي-الشبكات-العصبية\">ما هي الشبكات العصبية؟\u003C/h2>\n\u003Cp>الشبكات العصبية هي نماذج حاسوبية مستوحاة من \u003Cstrong>هيكلية الدماغ البشري\u003C/strong>. تتكون من:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>الخلايا العصبية (Neurons)\u003C/strong>: وحدات معالجة صغيرة\u003C/li>\n\u003Cli>\u003Cstrong>الروابط (Connections)\u003C/strong>: تمرر المعلومات بين الخلايا\u003C/li>\n\u003Cli>\u003Cstrong>الأوزان (Weights)\u003C/strong>: تحدد قوة كل رابط\u003C/li>\n\u003C/ul>\n\u003Cpre class=\"astro-code github-dark\" style=\"background-color:#24292e;color:#e1e4e8; overflow-x: auto; white-space: pre-wrap; word-wrap: break-word;\" tabindex=\"0\" data-language=\"python\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:#F97583\">import\u003C/span>\u003Cspan style=\"color:#E1E4E8\"> numpy \u003C/span>\u003Cspan style=\"color:#F97583\">as\u003C/span>\u003Cspan style=\"color:#E1E4E8\"> np\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#F97583\">class\u003C/span>\u003Cspan style=\"color:#B392F0\"> SimpleNeuron\u003C/span>\u003Cspan style=\"color:#E1E4E8\">:\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#F97583\">    def\u003C/span>\u003Cspan style=\"color:#79B8FF\"> __init__\u003C/span>\u003Cspan style=\"color:#E1E4E8\">(self, input_size):\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#79B8FF\">        self\u003C/span>\u003Cspan style=\"color:#E1E4E8\">.weights \u003C/span>\u003Cspan style=\"color:#F97583\">=\u003C/span>\u003Cspan style=\"color:#E1E4E8\"> np.random.randn(input_size)\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#79B8FF\">        self\u003C/span>\u003Cspan style=\"color:#E1E4E8\">.bias \u003C/span>\u003Cspan style=\"color:#F97583\">=\u003C/span>\u003Cspan style=\"color:#E1E4E8\"> np.random.randn(\u003C/span>\u003Cspan style=\"color:#79B8FF\">1\u003C/span>\u003Cspan style=\"color:#E1E4E8\">)\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#E1E4E8\">    \u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#F97583\">    def\u003C/span>\u003Cspan style=\"color:#B392F0\"> activate\u003C/span>\u003Cspan style=\"color:#E1E4E8\">(self, x):\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#F97583\">        return\u003C/span>\u003Cspan style=\"color:#E1E4E8\"> np.dot(x, \u003C/span>\u003Cspan style=\"color:#79B8FF\">self\u003C/span>\u003Cspan style=\"color:#E1E4E8\">.weights) \u003C/span>\u003Cspan style=\"color:#F97583\">+\u003C/span>\u003Cspan style=\"color:#79B8FF\"> self\u003C/span>\u003Cspan style=\"color:#E1E4E8\">.bias\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\n\u003Ch2 id=\"كيف-تعمل-الخلية-العصبية\">كيف تعمل الخلية العصبية؟\u003C/h2>\n\u003Cp>تخيل أن الخلية العصبية مثل \u003Cstrong>مصفاة ذكية\u003C/strong>:\u003C/p>\n\u003Col>\n\u003Cli>تستقبل مدخلات متعددة\u003C/li>\n\u003Cli>تضرب كل مدخل في وزنه\u003C/li>\n\u003Cli>تجمع النتائج\u003C/li>\n\u003Cli>تمررها عبر دالة تنشيط\u003C/li>\n\u003C/ol>\n\u003Ch3 id=\"دالة-sigmoid\">دالة Sigmoid\u003C/h3>\n\u003Cpre class=\"astro-code github-dark\" style=\"background-color:#24292e;color:#e1e4e8; overflow-x: auto; white-space: pre-wrap; word-wrap: break-word;\" tabindex=\"0\" data-language=\"python\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:#F97583\">def\u003C/span>\u003Cspan style=\"color:#B392F0\"> sigmoid\u003C/span>\u003Cspan style=\"color:#E1E4E8\">(x):\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#F97583\">    return\u003C/span>\u003Cspan style=\"color:#79B8FF\"> 1\u003C/span>\u003Cspan style=\"color:#F97583\"> /\u003C/span>\u003Cspan style=\"color:#E1E4E8\"> (\u003C/span>\u003Cspan style=\"color:#79B8FF\">1\u003C/span>\u003Cspan style=\"color:#F97583\"> +\u003C/span>\u003Cspan style=\"color:#E1E4E8\"> np.exp(\u003C/span>\u003Cspan style=\"color:#F97583\">-\u003C/span>\u003Cspan style=\"color:#E1E4E8\">x))\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\n\u003Cp>هذه الدالة تحول أي رقم إلى قيمة بين 0 و 1، مثالية للاحتمالات!\u003C/p>\n\u003Ch2 id=\"من-خلية-واحدة-إلى-شبكة-عميقة\">من خلية واحدة إلى شبكة عميقة\u003C/h2>\n\u003Cp>عندما نربط مئات الخلايا العصبية معاً في طبقات متعددة، نحصل على:\u003C/p>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\u003Ctable>\u003Cthead>\u003Ctr>\u003Cth>النوع\u003C/th>\u003Cth>الوصف\u003C/th>\u003Cth>الاستخدام\u003C/th>\u003C/tr>\u003C/thead>\u003Ctbody>\u003Ctr>\u003Ctd>\u003Cstrong>الشبكات الضحلة\u003C/strong>\u003C/td>\u003Ctd>طبقة أو اثنتين\u003C/td>\u003Ctd>مشاكل بسيطة\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Cstrong>الشبكات العميقة\u003C/strong>\u003C/td>\u003Ctd>10+ طبقات\u003C/td>\u003Ctd>رؤية حاسوبية، NLP\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Cstrong>المحولات (Transformers)\u003C/strong>\u003C/td>\u003Ctd>بنية متقدمة\u003C/td>\u003Ctd>ChatGPT، الترجمة\u003C/td>\u003C/tr>\u003C/tbody>\u003C/table>\n\u003Ch2 id=\"الخلاصة\">الخلاصة\u003C/h2>\n\u003Cp>الشبكات العصبية ليست سحراً، بل هي \u003Cstrong>رياضيات منظمة\u003C/strong> مع الكثير من البيانات. في المقالات القادمة، سنغوص أعمق في كل نوع!\u003C/p>\n\u003Chr>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>نصيحة\u003C/strong>: ابدأ دائماً بفهم الخلية العصبية الواحدة قبل الانتقال للشبكات المعقدة.\u003C/p>\n\u003C/blockquote>\n\u003Cp>\u003Cstrong>هل أعجبك المقال؟\u003C/strong> \u003Ca href=\"#\">اشترك في النشرة البريدية\u003C/a> للحصول على جديدنا كل أسبوع!\u003C/p>",{"headings":61,"localImagePaths":81,"remoteImagePaths":82,"frontmatter":83,"imagePaths":87},[62,65,69,72,76,79],{"depth":63,"slug":64,"text":42},1,"مقدمة-في-الشبكات-العصبية-كيف-تفكر-الآلة",{"depth":66,"slug":67,"text":68},2,"ما-هي-الشبكات-العصبية","ما هي الشبكات العصبية؟",{"depth":66,"slug":70,"text":71},"كيف-تعمل-الخلية-العصبية","كيف تعمل الخلية العصبية؟",{"depth":73,"slug":74,"text":75},3,"دالة-sigmoid","دالة Sigmoid",{"depth":66,"slug":77,"text":78},"من-خلية-واحدة-إلى-شبكة-عميقة","من خلية واحدة إلى شبكة عميقة",{"depth":66,"slug":80,"text":80},"الخلاصة",[],[],{"title":42,"description":43,"date":84,"image":85,"tags":86,"category":52,"readingTime":53,"featured":54,"draft":22},["Date","2026-04-11T00:00:00.000Z"],{"src":46,"alt":47},[49,50,21,51],[],"introduction-to-neural-networks.md"]