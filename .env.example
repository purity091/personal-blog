# Secret used to sign temporary download links.
BOOK_DOWNLOAD_SECRET=replace-with-a-long-random-secret

# Optional: webhook URL for Google Apps Script, Formspree, Make, Zapier, etc.
# The endpoint will POST { email, bookSlug, submittedAt } to this URL.
BOOK_LEADS_WEBHOOK_URL=https://example.com/book-leads-webhook
