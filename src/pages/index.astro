---
// Static page — reads from local markdown files (synced from Sanity via GitHub Action)
export const prerender = true;

import { getCollection } from 'astro:content';
import { fetchProjects } from '../lib/projects';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.tsx';
import Hero from '../components/Hero.tsx';
import FeaturedArticles from '../components/FeaturedArticles.tsx';
import WorkTimeline from '../components/WorkTimeline.tsx';
import AITermsExplorer from '../components/AITermsExplorer.tsx';
import MyBookSlider from '../components/MyBookSlider.tsx';
import SocialBentoGrid from '../components/SocialBentoGrid.tsx';
import FooterReflect from '../components/FooterReflect.tsx';

const buildTime = new Date().toLocaleString('ar-EG', { 
  timeZone: 'Asia/Riyadh',
  hour: '2-digit',
  minute: '2-digit',
  second: '2-digit',
  day: '2-digit',
  month: '2-digit',
  year: 'numeric',
  numberingSystem: 'latn'
});

// Read from local markdown files in src/content/blog/ (synced from Sanity)
const allPosts = await getCollection('blog');

// Filter and sort: Featured first, then by date (newest first), excluding drafts
const publishedPosts = allPosts
  .filter(post => !post.data.draft)
  .sort((a, b) => {
    if (a.data.featured !== b.data.featured) {
      return a.data.featured ? -1 : 1;
    }
    return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
  });

// Get the latest 6-9 posts for the home page (increased from 3)
const featuredPosts = publishedPosts.slice(0, 9);
const projects = await fetchProjects();

console.log('--- BUILD INFO ---');
console.log('Total files found in src/content/blog:', allPosts.length);
console.log('Total published articles:', publishedPosts.length);
console.log('Post slugs:', publishedPosts.map(p => p.slug).join(', '));
console.log('------------------');
---

<BaseLayout title="محمد لحلح | خبير الذكاء الاصطناعي - تعلم AI والشبكات العصبية">
  <Navbar client:load />
  <main>
    <Hero client:load />
    <FeaturedArticles articles={featuredPosts} client:visible />
    {projects.length > 0 && <WorkTimeline projects={projects.slice(0, 3)} showAllLink />}
    <AITermsExplorer client:visible />
    <MyBookSlider client:visible />
    <SocialBentoGrid client:visible />
  </main>
  <FooterReflect client:visible />
  <div class="hidden">Build Time: {buildTime}</div>
</BaseLayout>
