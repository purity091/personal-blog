---
// Static page — reads from local markdown files (synced from Sanity via GitHub Action)
export const prerender = true;

import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.tsx';
import Hero from '../components/Hero.tsx';
import FeaturedArticles from '../components/FeaturedArticles.tsx';
import AITermsExplorer from '../components/AITermsExplorer.tsx';
import MyBookSlider from '../components/MyBookSlider.tsx';
import SocialBentoGrid from '../components/SocialBentoGrid.tsx';
import DeepLearningTensors from '../components/DeepLearningTensors.tsx';
import LLMEcosystem from '../components/LLMEcosystem.tsx';
import FooterReflect from '../components/FooterReflect.tsx';

// Read from local markdown files in src/content/blog/ (synced from Sanity)
const allPosts = await getCollection('blog');

// Filter and sort: Featured first, then by date (newest first), excluding drafts
const publishedPosts = allPosts
  .filter(post => !post.data.draft)
  .sort((a, b) => {
    if (a.data.featured !== b.data.featured) {
      return a.data.featured ? -1 : 1;
    }
    return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
  });

// Get the latest 3-4 posts for the home page
const featuredPosts = publishedPosts.slice(0, 3);

console.log('📝 Total posts:', allPosts.length, '| Published:', publishedPosts.length, '| Featured:', featuredPosts.length);
---

<BaseLayout title="محمد لحلح | خبير الذكاء الاصطناعي - تعلم AI والشبكات العصبية">
  <Navbar client:load />
  <main>
    <Hero client:load />
    <FeaturedArticles articles={featuredPosts} />
    <DeepLearningTensors client:visible />
    <AITermsExplorer client:visible />
    <MyBookSlider client:visible />
    <SocialBentoGrid client:visible />
    <LLMEcosystem client:visible />
  </main>
  <FooterReflect client:visible />
</BaseLayout>
