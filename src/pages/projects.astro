---
export const prerender = true;

import { BriefcaseBusiness, ArrowRight } from 'lucide-react';
import { fetchProjects } from '../lib/projects';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.tsx';
import WorkTimeline from '../components/WorkTimeline.tsx';
import FooterReflect from '../components/FooterReflect.tsx';

const projects = await fetchProjects();
---

<BaseLayout
  title="مشاريعي وتجربتي العملية | محمد لحلح"
  description="استكشف مشاريعي وتجربتي العملية والمهام والتقنيات التي عملت عليها."
>
  <Navbar client:load />

  <main class="min-h-screen bg-[var(--bg-primary)] pt-16 transition-colors duration-300">
    {projects.length > 0 ? (
      <WorkTimeline projects={projects} />
    ) : (
      <section class="px-6 py-32 text-center" dir="rtl">
        <div class="mx-auto flex max-w-xl flex-col items-center gap-5">
          <div class="flex h-16 w-16 items-center justify-center rounded-full bg-[var(--accent-purple)]/10 text-[var(--accent-purple)]">
            <BriefcaseBusiness size={30} />
          </div>
          <h1 class="text-3xl font-black text-[var(--text-primary)] md:text-5xl">مشاريعي وتجربتي العملية</h1>
          <p class="text-base font-medium leading-7 text-[var(--text-secondary)]">
            ستظهر المشاريع المنشورة هنا قريبًا.
          </p>
          <a href="/" class="inline-flex items-center gap-2 text-sm font-black text-[var(--accent-purple)] hover:text-[var(--text-primary)]">
            العودة إلى الصفحة الرئيسية
            <ArrowRight size={16} />
          </a>
        </div>
      </section>
    )}
  </main>

  <FooterReflect client:visible />
</BaseLayout>
