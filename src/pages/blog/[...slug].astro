---
export const prerender = false;
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import { client, postBySlugQuery, markdownToHtml } from '../../lib/sanity';

const { slug } = Astro.params;

if (import.meta.env.SSR) {
  console.log('Attempting to fetch blog post with slug:', slug);
}

let fullPost;
try {
  fullPost = await client.fetch(postBySlugQuery, { slug });
  if (import.meta.env.SSR) {
    if (fullPost) {
       console.log('Successfully fetched post:', fullPost.title);
    } else {
       console.warn('No post found for slug:', slug);
    }
  }
} catch (err) {
  console.error('Failed to fetch post from Sanity:', err);
}

if (!fullPost) {
  return Astro.redirect('/404');
}

const contentHtml = typeof fullPost.content === 'string'
  ? await markdownToHtml(fullPost.content)
  : '';
---

<BlogPostLayout
  title={fullPost.title || 'بدون عنوان'}
  description={fullPost.description || ''}
  date={fullPost.publishDate ? new Date(fullPost.publishDate) : new Date()}
  image={fullPost.imageUrl}
  tags={fullPost.tags || []}
  readingTime={fullPost.readingTime || 5}
>
  <Fragment slot="category">
    <span class="inline-block px-3 py-1 rounded-full bg-[var(--accent-purple)]/10 text-[var(--accent-purple)] text-xs font-bold border border-[var(--accent-purple)]/20">
      {fullPost.category}
    </span>
  </Fragment>

  <div class="prose prose-lg max-w-none" set:html={contentHtml} />
</BlogPostLayout>
