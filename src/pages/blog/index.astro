---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.tsx';
import FooterReflect from '../../components/FooterReflect.tsx';
import { client, postsQuery } from '../../lib/sanity';
import { Calendar, Clock, ChevronLeft, ArrowLeft } from 'lucide-react';

interface SanityPost {
  _id: string;
  title: string;
  slug: { current: string };
  description: string;
  publishDate: string;
  imageUrl?: string;
  category: string;
  tags?: string[];
  readingTime?: number;
  featured?: boolean;
}

// Fetch all published posts from Sanity CMS
const publishedPosts: SanityPost[] = await client.fetch(postsQuery);
---

<BaseLayout title="المدونة | محمد لحلح - مقالات الذكاء الاصطناعي" description="مقالات متعمقة حول الذكاء الاصطناعي، التعلم العميق، والشبكات العصبية">
  <Navbar client:load />

  <main class="min-h-screen bg-[var(--bg-primary)] transition-colors duration-300">
    <!-- Header -->
    <section class="relative pt-32 pb-16 px-6 border-b border-[var(--border-subtle)] overflow-hidden">
      {/* Background glow decoration */}
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-[var(--accent-purple)]/5 blur-[120px] rounded-full pointer-events-none"></div>

      <div class="max-w-6xl mx-auto text-center relative z-10">

        <h1 class="text-4xl md:text-6xl font-black mb-6 hero-gradient tracking-tighter leading-tight">
          مقالات في <span class="text-[var(--text-muted)]">الذكاء الاصطناعي.</span>
        </h1>
        <p class="text-base md:text-lg text-[var(--text-secondary)] max-w-2xl mx-auto leading-relaxed font-medium">
          شروحات متعمقة، تحليلات تقنية، ورؤى مستقبلية حول عالم الذكاء الاصطناعي والشبكات العصبية بأسلوب بسيط وممتع.
        </p>
      </div>
    </section>

    <!-- Blog Posts Grid -->
    <section class="py-16 px-6">
      <div class="max-w-6xl mx-auto">
        {publishedPosts.length === 0 ? (
          <div class="text-center py-20 flex flex-col items-center gap-4">
             <div class="w-16 h-16 rounded-full bg-[var(--bg-tertiary)] flex items-center justify-center text-[var(--text-muted)]">
                <Clock size={32} />
             </div>
             <p class="text-[var(--text-secondary)] text-lg font-bold">لا توجد مقالات منشورة بعد</p>
             <a href="/" class="text-[var(--accent-purple)] text-sm font-bold hover:underline flex items-center gap-2">العودة للرئيسية <ArrowLeft size={16} /></a>
          </div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {publishedPosts.map((post) => (
              <a href={`/blog/${post.slug.current}`} class="group glass-card flex flex-col rounded-2xl md:min-h-[260px] overflow-hidden cursor-pointer border border-[var(--border-subtle)] hover:border-[var(--accent-purple)]/40 hover:scale-[1.01] transition-all duration-300 relative">
                <!-- Subtle Gradient background hover -->
                <div class="absolute inset-0 bg-gradient-to-br from-purple-500/5 to-blue-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500" />

                <div class="p-6 md:p-8 flex flex-col flex-1 relative z-10">
                  <div class="flex items-center justify-between mb-4">
                    <span class="px-2.5 py-1 rounded-md bg-[var(--accent-purple)]/10 border border-[var(--accent-purple)]/20 text-[9px] md:text-[10px] font-black text-[var(--accent-purple)] shadow-sm">
                      {post.category}
                    </span>

                    <div class="flex items-center gap-1.5 text-[9px] md:text-[10px] font-medium text-[var(--text-muted)]">
                      <Calendar size={12} />
                      <time datetime={new Date(post.publishDate).toISOString()}>
                        {new Intl.DateTimeFormat('ar-EG', {
                          year: 'numeric',
                          month: 'long',
                          day: 'numeric',
                        }).format(new Date(post.publishDate))}
                      </time>
                    </div>
                  </div>

                  <h2 class="text-lg md:text-xl font-black text-[var(--text-primary)] mb-3 leading-snug group-hover:text-[var(--accent-purple)] transition-colors">
                    {post.title}
                  </h2>

                  <p class="text-[var(--text-secondary)] text-xs md:text-sm leading-relaxed mb-6 font-medium line-clamp-3">
                    {post.description}
                  </p>

                  <div class="mt-auto pt-4 border-t border-[var(--border-subtle)] group-hover:border-[var(--accent-purple)]/20 transition-colors flex flex-col gap-4">
                    {/* Tags */}
                    {post.tags && post.tags.length > 0 && (
                      <div class="flex flex-wrap gap-2">
                        {post.tags.slice(0, 3).map((tag: string) => (
                          <span class="text-[9px] font-bold text-[var(--text-muted)] group-hover:text-[var(--accent-purple)] bg-[var(--bg-tertiary)] border border-[var(--border-subtle)] px-2 py-0.5 rounded-md transition-colors">
                            #{tag}
                          </span>
                        ))}
                      </div>
                    )}

                    {/* Meta & Arrow */}
                    <div class="flex items-center justify-between">
                      <span class="text-[10px] font-bold flex items-center gap-1.5 text-[var(--text-muted)]">
                        <Clock size={12} /> وقت القراءة: {post.readingTime} دقائق
                      </span>
                      <div
                        class="w-8 h-8 rounded-full bg-[var(--bg-tertiary)] group-hover:bg-[var(--accent-purple)] flex items-center justify-center text-[var(--text-secondary)] group-hover:text-white transition-all shadow-sm"
                      >
                        <ChevronLeft size={14} />
                      </div>
                    </div>
                  </div>
                </div>
              </a>
            ))}
          </div>
        )}
      </div>
    </section>
  </main>

  <FooterReflect client:load />
</BaseLayout>

<style>
  .hero-gradient {
    background: linear-gradient(135deg, var(--text-primary) 0%, var(--text-secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
</style>

