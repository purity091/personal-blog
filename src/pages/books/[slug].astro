---
export const prerender = true;

export async function getStaticPaths() {
  return books.map((book) => ({
    params: { slug: book.slug },
    props: { book },
  }));
}

import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.tsx';
import FooterReflect from '../../components/FooterReflect.tsx';
import { books, getBookBySlug } from '../../data/books';

const { slug } = Astro.params;
const { book: propsBook } = Astro.props;
const book = propsBook || getBookBySlug(slug || '');

if (!book) {
  return Astro.redirect('/404');
}
---

<BaseLayout title={`${book.title} | محمد لحلح`} description={book.description} image={book.image}>
  <Navbar client:load />

  <main class="relative bg-[var(--bg-primary)] min-h-screen pt-24 overflow-hidden text-right" dir="rtl">
    <!-- Immersive Cinematic Background -->
    <div class="fixed inset-0 pointer-events-none z-0">
      <div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-[var(--accent-purple)]/10 blur-[120px] animate-blob"></div>
      <div class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-blue-500/10 blur-[120px] animate-blob animation-delay-2000"></div>
      <div class="absolute inset-0 bg-[url('/grid.svg')] bg-center [mask-image:linear-gradient(180deg,white,rgba(255,255,255,0))] opacity-20"></div>
    </div>

    <!-- Immersive Cinematic Background -->
    <div class="fixed inset-0 pointer-events-none z-0">
      <div class="absolute top-[-10%] start-[-10%] w-[50%] h-[50%] bg-[var(--accent-purple)]/10 blur-[150px] animate-blob"></div>
      <div class="absolute bottom-[-10%] end-[-10%] w-[50%] h-[50%] bg-blue-500/10 blur-[150px] animate-blob animation-delay-2000"></div>
      <div class="absolute inset-0 bg-[url('/grid.svg')] bg-center opacity-[0.07]"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10">
      
      <!-- Compact Expert Layout: Balanced Split Hero -->
      <section class="flex flex-col lg:flex-row gap-10 lg:gap-16 py-8 lg:py-14 items-center">
        
        <!-- Left Side: Core Information & Actions -->
        <div class="flex-1 space-y-6 order-2 lg:order-1 text-right">
          <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-white/5 border border-white/10 backdrop-blur-md">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-purple)] animate-pulse"></span>
            <span class="text-[9px] font-black uppercase tracking-widest text-[var(--text-secondary)]">{book.eyebrow}</span>
          </div>

          <h1 class="text-3xl md:text-5xl lg:text-6xl font-black text-[var(--text-primary)] leading-[1.1] tracking-tighter">
            {book.title}
          </h1>

          <p class="text-base md:text-xl text-[var(--text-secondary)] font-medium max-w-xl leading-relaxed opacity-90">
            {book.subtitle}
          </p>

          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
            {book.format.map(item => (
              <div class="p-4 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-xl group hover:bg-white/10 transition-all border-b-2 border-b-transparent hover:border-b-[var(--accent-purple)] text-center">
                <span class="block text-[8px] font-black text-[var(--accent-purple)] uppercase tracking-[0.2em] mb-1">{item.label}</span>
                <span class="text-base font-black text-[var(--text-primary)]">{item.value}</span>
              </div>
            ))}
          </div>

          <div class="flex flex-col sm:flex-row gap-3">
            <a href={`/image/${book.slug}.pdf`} class="btn-primary py-3.5 px-10 text-lg">
              حمّل نسختك الآن
            </a>
            <a href="#roadmap" class="btn-secondary py-3.5 px-10 text-lg">
              تصفح المحتويات
            </a>
          </div>
        </div>

        <!-- Right Side: Visual Centerpiece -->
        <div class="flex-1 flex justify-center lg:justify-end order-1 lg:order-2">
          <div class="relative group perspective-2000">
            <div class="relative z-10 w-48 md:w-[320px] aspect-[3/4.2] transition-all duration-1000 transform group-hover:rotate-y-[-20deg] group-hover:rotate-x-[5deg] group-hover:scale-105">
              <img src={book.image} alt={book.title} class="w-full h-full object-cover rounded-[1.5rem] shadow-[0_40px_80px_-15px_rgba(0,0,0,0.8)] border border-white/10" />
              <!-- Book Spine Effect - Logical Start -->
              <div class="absolute inset-y-0 start-0 w-4 bg-gradient-to-l from-black/60 to-transparent backdrop-blur-[1px] rounded-s-[1.5rem] opacity-0 group-hover:opacity-100 transition-opacity"></div>
              <div class="absolute inset-y-0 end-0 w-1 bg-white/10 rounded-e-[1.5rem]"></div>
            </div>
            <!-- Subtler Aura -->
            <div class="absolute -inset-10 bg-[var(--accent-purple)]/20 blur-[80px] rounded-full z-0 opacity-30 group-hover:opacity-60 transition-all duration-1000"></div>
          </div>
        </div>

      </section>

      <!-- Advanced Insights Section: Compact Grid -->
      <section id="roadmap" class="py-16 border-t border-white/5">
        <div class="grid lg:grid-cols-3 gap-10 lg:gap-14">
          
          <!-- Column 1: Roadmap (Dominant) -->
          <div class="lg:col-span-2 space-y-8">
            <div class="flex items-center gap-4">
              <h2 class="text-2xl md:text-4xl font-black tracking-tight whitespace-nowrap">محاور الكتاب</h2>
              <div class="h-px w-full bg-gradient-to-r from-white/10 to-transparent"></div>
            </div>

            <div class="grid md:grid-cols-2 gap-4 relative">
              {book.chapters.map((chapter, idx) => (
                <div class="group relative p-6 rounded-[2rem] bg-white/5 border border-white/5 hover:border-white/10 hover:bg-white/[0.08] transition-all duration-500 overflow-hidden">
                  <div class="absolute top-0 end-0 p-4 opacity-5 group-hover:opacity-10 transition-opacity text-6xl font-black">
                    {idx + 1}
                  </div>
                  <div class="relative z-10">
                    <span class="inline-block px-2 py-0.5 rounded-md bg-[var(--accent-purple)]/20 text-[var(--accent-purple)] text-[10px] font-black mb-2">الفصل {idx + 1}</span>
                    <h4 class="text-lg md:text-xl font-black mb-2 group-hover:text-[var(--accent-purple)] transition-colors">{chapter.title}</h4>
                    <p class="text-[var(--text-muted)] text-sm md:text-base leading-relaxed group-hover:text-[var(--text-secondary)] transition-colors">{chapter.summary}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Column 2: Sticky Side Dashboard -->
          <div class="space-y-8">
            <div class="sticky top-24 space-y-8">
              
              <div class="p-7 md:p-8 rounded-[2.5rem] bg-white/5 border border-white/10 backdrop-blur-3xl relative overflow-hidden group">
                <div class="absolute inset-0 bg-gradient-to-br from-[var(--accent-purple)]/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                <h2 class="text-2xl font-black mb-6">القيمة العلمية</h2>
                
                <div class="space-y-6">
                  <div>
                    <h3 class="text-[9px] font-black text-[var(--accent-purple)] mb-3 tracking-[0.3em] uppercase">من المستفيد؟</h3>
                    <div class="space-y-2.5">
                      {book.audience.map(item => (
                        <div class="flex items-center gap-2.5 text-sm md:text-base text-[var(--text-secondary)] font-medium">
                          <div class="w-1 h-1 rounded-full bg-[var(--accent-purple)]"></div>
                          <span>{item}</span>
                        </div>
                      ))}
                    </div>
                  </div>

                  <div class="pt-6 border-t border-white/5">
                    <h3 class="text-[9px] font-black text-[var(--accent-purple)] mb-3 tracking-[0.3em] uppercase">مخرجات التعلم</h3>
                    <div class="space-y-3">
                      {book.outcomes.map(outcome => (
                        <div class="flex items-start gap-3 text-sm group">
                          <div class="mt-1 p-0.5 rounded-full bg-emerald-500/20 text-emerald-500">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
                          </div>
                          <span class="text-[var(--text-secondary)] group-hover:text-[var(--text-primary)] transition-colors">{outcome}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>

              <!-- Compact Action Card -->
              <div class="p-8 rounded-[2.5rem] bg-white/[0.03] border border-white/10 text-center">
                <h4 class="text-lg font-black mb-3">جاهز للبدء؟</h4>
                <a href={`/image/${book.slug}.pdf`} class="inline-block w-full py-3.5 rounded-xl bg-white text-black text-sm font-black hover:scale-105 transition-all">
                  تحميل النسخة الكاملة
                </a>
              </div>

            </div>
          </div>

        </div>
      </section>

      <!-- Compact Footer CTA -->
      <section class="py-20">
        <div class="relative p-10 md:p-16 rounded-[4rem] bg-white/[0.02] border border-white/5 text-center overflow-hidden group">
          <div class="absolute -top-20 -start-20 w-64 h-64 bg-[var(--accent-purple)]/10 blur-[100px] rounded-full"></div>
          
          <div class="relative z-10 max-w-3xl mx-auto">
            <h2 class="text-4xl md:text-6xl font-black mb-6 tracking-tighter">مستقبل الذكاء الاصطناعي <br/> <span class="text-[var(--accent-purple)] text-3xl md:text-5xl">بين يديك</span></h2>
            <p class="text-lg text-[var(--text-secondary)] mb-10 leading-relaxed opacity-80">{book.heroNote}</p>
            <div class="flex flex-col sm:flex-row justify-center gap-4">
              <a href={`/image/${book.slug}.pdf`} class="btn-primary px-12 py-4 text-xl shadow-xl">تحميل الكتاب</a>
              <a href="/books" class="btn-secondary px-12 py-4 text-xl">العودة للمكتبة</a>
            </div>
          </div>
        </div>
      </section>

    </div>

    </div>

    </div>

    </div>
  </main>

  <FooterReflect client:visible />
</BaseLayout>

<style>
  .btn-primary {
    @apply inline-flex items-center justify-center rounded-2xl bg-[var(--accent-purple)] text-white px-12 py-5 text-xl font-black transition-all hover:scale-[1.05] hover:shadow-[0_20px_50px_-15px_rgba(168,85,247,0.5)];
  }

  .btn-secondary {
    @apply inline-flex items-center justify-center rounded-2xl border border-white/10 bg-white/5 px-12 py-5 text-[var(--text-primary)] text-xl font-bold backdrop-blur-md transition-all hover:bg-white/10;
  }

  h1, h2, h3, h4 {
    font-family: var(--font-arabic);
  }

  @keyframes blob {
    0% { transform: translate(0px, 0px) scale(1); }
    33% { transform: translate(30px, -50px) scale(1.1); }
    66% { transform: translate(-20px, 20px) scale(0.9); }
    100% { transform: translate(0px, 0px) scale(1); }
  }
  .animate-blob {
    animation: blob 7s infinite;
  }
  .animation-delay-2000 {
    animation-delay: 2s;
  }

  .perspective-1000 {
    perspective: 1000px;
  }
</style>
