---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.tsx';
import FooterReflect from '../../components/FooterReflect.tsx';
import { books } from '../../data/books';
---

<BaseLayout title="المكتبة التقنية | محمد لحلح" description="استكشف مؤلفات محمد لحلح في الذكاء الاصطناعي، تعلم الآلة، والتقنيات الحديثة.">
  <Navbar client:load />

  <main class="relative bg-[var(--bg-primary)] min-h-screen pt-28 pb-20">
    <!-- Sophisticated Ambient BG -->
    <div class="fixed inset-0 pointer-events-none z-0">
      <div class="absolute top-0 left-0 w-full h-[30vh] bg-gradient-to-b from-[var(--bg-secondary)] to-transparent opacity-50"></div>
      <div class="absolute top-1/4 right-1/4 w-[20rem] h-[20rem] bg-[var(--accent-purple)]/5 blur-[100px]"></div>
    </div>

    <div class="relative z-10 max-w-6xl mx-auto px-6">
      <!-- Refined Header: Compact & Professional -->
      <header class="max-w-3xl mb-20 text-right">
        <div class="flex items-center gap-3 mb-6">
           <div class="w-1.5 h-6 bg-[var(--accent-purple)] rounded-full"></div>
           <span class="text-xs font-black text-[var(--accent-purple)] uppercase tracking-widest">Digital Archive</span>
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-black text-[var(--text-primary)] mb-6 leading-tight tracking-tighter">
          المكتبة التقنية
        </h1>
        <p class="text-base md:text-lg text-[var(--text-secondary)] leading-relaxed max-w-xl opacity-80">
          مجموعة مختارة من الإصدارات التي تلخص رحلتي في تبسيط مفاهيم الذكاء الاصطناعي وهندسة البرمجيات للعقل العربي.
        </p>
      </header>

      <!-- Compact Smart Grid: 3 columns on desktop -->
      <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {books.map((book) => (
          <article class="group relative">
            <a href={`/books/${book.slug}`} class="block h-full">
              <div class="relative flex flex-col h-full rounded-3xl bg-white/[0.02] border border-white/5 hover:border-[var(--accent-purple)]/30 hover:bg-white/[0.04] transition-all duration-500 overflow-hidden group/card p-6">
                
                {/* 3D Book Visual Container */}
                <div class="relative aspect-[3/4] mb-8 flex items-center justify-center bg-[var(--bg-secondary)] rounded-2xl overflow-hidden border border-white/5 transition-all group-hover/card:shadow-[0_20px_40px_-10px_rgba(0,0,0,0.5)]">
                  <div class="relative w-32 md:w-40 transition-all duration-700 group-hover/card:scale-105 group-hover/card:-rotate-3">
                    <img src={book.image} alt={book.title} class="rounded-md shadow-[0_15px_30px_rgba(0,0,0,0.4)]" />
                    <div class="absolute -inset-4 bg-[var(--accent-purple)]/20 blur-2xl rounded-full -z-10 opacity-0 group-hover/card:opacity-100 transition-opacity"></div>
                  </div>
                  
                  {/* Category Overlay */}
                  <div class="absolute top-4 left-4 px-2.5 py-1 rounded-lg bg-black/60 backdrop-blur-md border border-white/10 text-[8px] font-black text-white uppercase tracking-widest">
                    {book.format[2].value}
                  </div>
                </div>

                {/* Compact Metadata */}
                <div class="flex-1 text-right flex flex-col">
                  <div class="flex items-center justify-end gap-2 mb-3">
                    <span class="text-[9px] font-black text-[var(--text-muted)] uppercase tracking-widest">{book.eyebrow}</span>
                    <div class="w-1 h-1 rounded-full bg-[var(--accent-purple)]"></div>
                  </div>
                  
                  <h2 class="text-xl md:text-2xl font-black text-[var(--text-primary)] mb-3 group-hover/card:text-[var(--accent-purple)] transition-colors">
                    {book.title}
                  </h2>
                  
                  <p class="text-sm text-[var(--text-secondary)] leading-relaxed mb-6 opacity-70 line-clamp-3">
                    {book.description}
                  </p>

                  <div class="mt-auto pt-4 border-t border-white/5 flex items-center justify-end gap-2 text-xs font-bold text-[var(--text-primary)] group-hover/card:gap-4 transition-all">
                    <span>استكشف المحتوى</span>
                    <svg class="w-4 h-4 transition-transform group-hover/card:translate-x-[-2px]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                    </svg>
                  </div>
                </div>
              </div>
            </a>
          </article>
        ))}
      </section>

      <!-- Minimalist Contact Section -->
      <footer class="mt-40 py-20 border-t border-white/5 text-center">
        <h2 class="text-3xl md:text-4xl font-black mb-6">هل تبحث عن تعاون تقني؟</h2>
        <p class="text-base text-[var(--text-secondary)] mb-10 max-w-xl mx-auto leading-relaxed opacity-80">
          أنا متاح دائماً لنقاش المشاريع البرمجية واستشارات الذكاء الاصطناعي.
        </p>
        <a href="/#social" class="inline-flex items-center justify-center rounded-xl bg-white text-black px-10 py-4 text-base font-black transition-all hover:scale-105 active:scale-95">
          تواصل معي الآن
        </a>
      </footer>
    </div>
  </main>

  <FooterReflect client:visible />
</BaseLayout>

<style>
  h1, h2, p, span {
    font-family: var(--font-arabic);
  }
</style>
