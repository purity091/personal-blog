---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.tsx';
import FooterReflect from '../../components/FooterReflect.tsx';
import { books } from '../../data/books';
---

<BaseLayout title="المكتبة التقنية | محمد لحلح" description="استكشف مؤلفات محمد لحلح في الذكاء الاصطناعي، تعلم الآلة، والتقنيات الحديثة.">
  <Navbar client:load />

  <main class="relative bg-[var(--bg-primary)] min-h-screen pt-40 pb-32">
    <!-- Sophisticated BG -->
    <div class="fixed inset-0 pointer-events-none z-0">
      <div class="absolute top-0 left-0 w-full h-[50vh] bg-gradient-to-b from-[var(--bg-secondary)] to-transparent"></div>
      <div class="absolute top-1/4 right-1/4 w-[30rem] h-[30rem] bg-[var(--accent-purple)]/5 blur-[120px]"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-6">
      <!-- Header -->
      <header class="max-w-3xl mb-32 text-right">
        <span class="inline-block px-4 py-1.5 rounded-full bg-[var(--accent-purple)]/10 text-[var(--accent-purple)] text-xs font-black uppercase tracking-widest mb-8">
          The Archive
        </span>
        <h1 class="text-6xl md:text-8xl font-black text-[var(--text-primary)] mb-10 leading-tight">
          المكتبة التقنية
        </h1>
        <p class="text-xl md:text-2xl text-[var(--text-secondary)] leading-relaxed border-r-4 border-[var(--accent-purple)] pr-8">
          مؤلفات تجمع بين العمق الأكاديمي والخبرة التطبيقية في مجالات الذكاء الاصطناعي وهندسة البرمجيات.
        </p>
      </header>

      <!-- Smart Grid -->
      <section class="grid md:grid-cols-2 gap-x-12 gap-y-32 lg:gap-x-24">
        {books.map((book) => (
          <article class="group">
            <a href={`/books/${book.slug}`} class="block">
              <!-- Visual Container -->
              <div class="relative aspect-[16/10] mb-12 rounded-[2rem] overflow-hidden bg-[var(--bg-secondary)] border border-[var(--border-subtle)] transition-all duration-700 group-hover:border-[var(--accent-purple)]/40 group-hover:shadow-[0_40px_80px_-20px_rgba(0,0,0,0.5)]">
                <div class="absolute inset-0 flex items-center justify-center p-12">
                  <div class="relative w-48 md:w-64 transition-transform duration-700 group-hover:scale-110 group-hover:-rotate-3">
                    <img src={book.image} alt={book.title} class="rounded-lg shadow-2xl" />
                    <div class="absolute -inset-8 bg-[var(--accent-purple)]/10 blur-3xl rounded-full -z-10 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                  </div>
                </div>
                <!-- Format Badge -->
                <div class="absolute top-8 left-8 px-4 py-2 rounded-xl bg-black/40 backdrop-blur-md border border-white/10 text-xs font-black text-white uppercase tracking-widest">
                  {book.format[2].value}
                </div>
              </div>

              <!-- Metadata -->
              <div class="text-right px-4">
                <div class="flex items-center justify-end gap-3 mb-6">
                  <span class="text-xs font-black text-[var(--text-muted)] uppercase tracking-widest">{book.eyebrow}</span>
                  <div class="h-1.5 w-1.5 rounded-full bg-[var(--accent-purple)]"></div>
                </div>
                
                <h2 class="text-3xl md:text-5xl font-black text-[var(--text-primary)] mb-6 transition-colors group-hover:text-[var(--accent-purple)]">
                  {book.title}
                </h2>
                
                <p class="text-lg md:text-xl text-[var(--text-secondary)] leading-relaxed mb-10 line-clamp-2">
                  {book.description}
                </p>

                <div class="inline-flex items-center gap-3 text-[var(--text-primary)] font-bold group-hover:gap-5 transition-all">
                  <span class="text-lg">تصفح الكتاب</span>
                  <svg class="w-6 h-6 transition-transform group-hover:translate-x-[-4px]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                  </svg>
                </div>
              </div>
            </a>
          </article>
        ))}
      </section>

      <!-- Smart CTA Footer -->
      <footer class="mt-56 py-32 border-t border-[var(--border-subtle)] text-center">
        <h2 class="text-4xl md:text-6xl font-black mb-10">هل ترغب في استشارة تقنية؟</h2>
        <p class="text-xl text-[var(--text-secondary)] mb-12 max-w-2xl mx-auto leading-relaxed">أقدم استشارات متخصصة للمؤسسات والمطورين حول بناء وتطوير أنظمة الذكاء الاصطناعي.</p>
        <a href="/#social" class="inline-flex items-center justify-center rounded-2xl bg-[var(--accent-purple)] text-white px-16 py-6 text-xl font-black transition-all hover:scale-105 hover:shadow-[0_20px_50px_-15px_rgba(168,85,247,0.4)]">
          تواصل معي
        </a>
      </footer>
    </div>
  </main>

  <FooterReflect client:visible />
</BaseLayout>

<style>
  h1, h2, p, span {
    font-family: var(--font-arabic);
  }
</style>
